{
  "name": "PC Queue",
  "description": "PC Queue has moved to CardScout. Try CardScout for queue tracking and more.",
  "version": "1.3",
  "manifest_version": 3,
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.pokemoncenter.com/*",
    "https://api.cardscout.co/*"
  ],
  "action": {
    "default_icon": "favicon.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": [
        "https://www.pokemoncenter.com/*"
      ],
      "all_frames": true
    }
  ]
}